<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Send to LightBurn</name>
  <id>org.lightburn_helper.send_to_lightburn</id>
  <param name="mode" type="string" gui-hidden="true">open</param>

  <param name="selection_only" type="bool" gui-text="Selected objects only">false</param>
  <param name="text_to_paths" type="bool" gui-text="Convert text (and shapes) to paths">true</param>
  <param name="ungroup" type="bool" gui-text="Ungroup everything">false</param>

  <param name="connection" type="optiongroup" appearance="combo"
         gui-text="Connection method:">
    <option value="auto">Auto (try REST API, then UDP, start LightBurn if needed)</option>
<!--    <option value="rest">REST API (port 19520)</option>-->
    <option value="udp">UDP only - older LightBurn before 2.2</option>
  </param>

  <param name="lb_build" type="optiongroup" appearance="combo"
         gui-text="If LightBurn isn't running, start:">
    <option value="release">LightBurn</option>
    <option value="prerelease">LightBurn (PreRelease)</option>
  </param>
  <param name="open_method" type="optiongroup" appearance="combo"
         gui-text="When opening with REST API:">
    <option value="merge">Merge into the current project</option>
    <option value="replace">Replace the current project</option>
  </param>

  <label>Sizes are measured on the path centre line. In Inkscape, set Edit &gt; Preferences &gt; Tools &gt; Bounding box to use: Geometric so the size you see matches what LightBurn imports.</label>

  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="LightBurn"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">lightburn_export.py</command>
  </script>
</inkscape-extension>
